# {{ ansible_managed }}
# wonder-critique API — {{ backend_domain }}
#
# Origin vhost: plain HTTP only. TLS is terminated at Cloudflare in front;
# Cloudflare talks to this port over HTTP. Do NOT listen on 443 here.
#
# Backend mounts probes at the root and its API under /api/v1; everything is
# proxied so unknown paths surface the backend's JSON 404.

upstream wonder_critique_backend {
    server {{ backend_upstream_host }}:{{ backend_upstream_port }};
    keepalive 64;
}

server {
    listen 80;
    listen [::]:80;
    server_name {{ backend_domain }};

    location / {
        proxy_pass http://wonder_critique_backend;

        proxy_http_version 1.1;
        # keepalive to the upstream, essential for SSE-friendly streaming
        proxy_set_header Connection "";

        proxy_set_header Host $host;

        # Client IP: Cloudflare sends CF-Connecting-IP / True-Client-IP with
        # the real client address; pass it through untouched. The backend's
        # chi RealIP middleware reads True-Client-IP, then X-Real-IP, then the
        # first X-Forwarded-For entry (the client CF saw).
        proxy_set_header True-Client-IP $http_true_client_ip;
        proxy_set_header CF-Connecting-IP $http_cf_connecting_ip;
        proxy_set_header X-Real-IP $http_cf_connecting_ip;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-Id $request_id;

        # Agent runs stream SSE events; nginx must not buffer them.
        proxy_buffering off;
        proxy_request_buffering on;
        proxy_read_timeout {{ nginx_proxy_read_timeout }};
        proxy_send_timeout {{ nginx_proxy_send_timeout }};
        proxy_cache off;

        client_max_body_size {{ nginx_client_max_body_size }};
    }
}
