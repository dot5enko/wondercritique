# {{ ansible_managed }}
# Environment for the wonder-critique backend (see internal/config/config.go).
APP_ENV={{ backend_app_env }}
LOG_LEVEL={{ backend_log_level }}
HTTP_ADDR={{ backend_http_addr }}
DB_PATH={{ backend_db_path }}
JWT_ISSUER={{ backend_jwt_issuer }}
JWT_SECRET={{ vault_jwt_secret }}
AGENT_MODEL={{ backend_agent_model }}
{% if backend_cors_origins | length > 0 %}
CORS_ORIGINS={{ backend_cors_origins | join(',') }}
{% endif %}
{% if vault_resend_api_key %}
RESEND_API_KEY={{ vault_resend_api_key }}
{% endif %}
{% if vault_mail_from %}
MAIL_FROM={{ vault_mail_from }}
{% endif %}
{% if vault_model_api_key %}
MODEL_API_KEY={{ vault_model_api_key }}
{% endif %}
# headless Chrome renderer (docs/backend.render.md)
RENDER_CHROME_PATH={{ backend_render_chrome_path }}
RENDER_CONCURRENCY={{ backend_render_concurrency }}
RENDER_TIMEOUT={{ backend_render_timeout }}
RENDER_ALLOWED_HOSTS={{ backend_render_allowed_hosts | join(',') }}
RENDER_CHROME_NO_SANDBOX={{ backend_render_chrome_no_sandbox | string | lower }}
