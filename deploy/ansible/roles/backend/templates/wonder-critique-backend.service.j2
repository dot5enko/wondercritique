# {{ ansible_managed }}
[Unit]
Description=wonder-critique API backend
Documentation=file:///opt/wonder-critique/README.md
Wants=network-online.target
After=network-online.target

[Service]
Type=exec
User={{ backend_service_name }}
Group={{ backend_service_name }}
EnvironmentFile={{ backend_env_file }}
# Chrome (render) needs a writable HOME and temp dir: ProtectSystem=strict
# makes the real /tmp read-only, so both live under the state directory.
Environment=HOME={{ backend_state_dir }}
Environment=TMPDIR={{ backend_state_dir }}/tmp
ExecStart={{ backend_binary_path }}
WorkingDirectory={{ backend_state_dir }}
StateDirectory={{ backend_state_dir | basename }}
StateDirectoryMode=0750

# The app shuts down gracefully (SSE streams allowed to drain). Past the
# deadline the runtime context is cancelled and connections are closed.
TimeoutStopSec=10s
TimeoutStartSec=30s
Restart=on-failure
RestartSec=2s

# Hardening. The binary is static Go (CGO_ENABLED=0) binding to
# {{ backend_http_addr }} only; it needs no capabilities and writes
# solely to the StateDirectory.
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectClock=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectControlGroups=true
ProtectProc=invisible
ProcSubset=pid
# The Go API needs none of these; Chrome's sandbox creates user, mount, PID
# and network namespaces (docs/deploy.ansible.md), so the allow-list keeps
# everything else (cgroup, ipc, uts, time) closed instead of a blanket true.
RestrictNamespaces=user mnt pid net
# AF_NETLINK: Chrome's network service watches link/route changes over it.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=multi-user.target
