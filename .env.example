# docker compose settings — copy to .env and adjust. Everything is optional.

# host port for the web app
PORT=8080

# dev: login codes are printed in `docker compose logs backend` (no email setup needed)
# prod: requires JWT_SECRET, SECRETS_KEY, RESEND_API_KEY and MAIL_FROM
APP_ENV=dev

# >= 32 bytes, e.g. `openssl rand -base64 48`; empty in dev => sessions reset on restart
JWT_SECRET=
# >= 32 bytes; encrypts provider API keys saved in Settings
SECRETS_KEY=

# comma-separated; these users get admin access (Studio, Settings)
ADMIN_EMAILS=you@example.com

# email delivery for login codes (prod)
RESEND_API_KEY=
MAIL_FROM=Wonder Critique <noreply@example.com>

# LLM provider keys (or add them later in Settings → Providers)
META_MODEL_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
