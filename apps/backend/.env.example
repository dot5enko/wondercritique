# dev | prod
APP_ENV=dev
# debug | info | warn | error
LOG_LEVEL=info
HTTP_ADDR=:8080
# comma-separated; empty disables CORS
CORS_ORIGINS=http://localhost:5173
DB_PATH=data/app.db

# required, >= 32 bytes in prod (e.g. `openssl rand -base64 48`);
# empty in dev => random per-process secret (tokens are lost on restart)
JWT_SECRET=change-me-to-a-long-random-secret-0123456789
JWT_ISSUER=wonder-critique
# empty => emails/login codes are logged instead of sent (dev only; prod refuses to start)
RESEND_API_KEY=
# required when RESEND_API_KEY is set
MAIL_FROM=Wonder Critique <noreply@example.com>

# Meta Model API; empty => agent routes return 503
MODEL_API_KEY=
AGENT_MODEL=muse-spark-1.3-contributor
